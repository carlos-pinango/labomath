{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "labomath",
      "runtimeExecutable": "/usr/bin/ruby",
      "runtimeArgs": [
        "-e",
        "require 'webrick'; s=WEBrick::HTTPServer.new(Port:3456,DocumentRoot:'/tmp/labomath',AccessLog:[],Logger:WEBrick::Log.new('/dev/null')); trap('INT'){s.shutdown}; s.start"
      ],
      "port": 3456
    }
  ]
}
